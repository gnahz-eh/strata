# Select anthropic or openai, and configure only that provider's key.
STRATA_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional model override. Leave unset to use the selected provider's default.
# STRATA_MODEL=claude-sonnet-4-6
# For OpenAI, for example: STRATA_MODEL=gpt-4.1-mini

# Optional OpenAI API endpoint override. Only use an endpoint you trust.
# OPENAI_BASE_URL=https://api.openai.com/v1
