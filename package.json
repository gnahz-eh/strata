{
  "name": "strata",
  "version": "0.2.0",
  "description": "A modular TypeScript runtime and CLI for AI-assisted development",
  "type": "module",
  "bin": {
    "strata": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "docs",
    "SECURITY.md",
    "examples/extensions"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "tsx src/cli/index.ts",
    "dev": "tsx watch src/cli/index.ts",
    "typecheck": "tsc --project tsconfig.test.json",
    "test": "node scripts/test.mjs",
    "test:package": "node --test tests/package.test.mjs tests/v1.package.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "ajv": "^8.20.0",
    "fast-glob": "^3.3.3",
    "openai": "^7.10.0",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
